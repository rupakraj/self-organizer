LoginScreen {
    align: center middle;
}

#login-box {
    width: 44;
    height: auto;
    padding: 1 2;
    border: round $primary;
}

#login-box Input {
    margin-top: 1;
}

#login-error {
    color: $error;
}

.hint {
    color: $accent;
}

#breadcrumb {
    height: 1;
    padding: 0 1;
    background: $primary;
    color: $text;
    text-style: bold;
}

#main-pane {
    height: 1fr;
    padding: 0 1;
}

#modeline {
    height: 1;
    background: $panel;
    color: $text;
}

#completions {
    display: none;
    height: auto;
    max-height: 8;
    padding: 0 1;
    border-top: solid $primary;
}

#command-row {
    height: 1;
}

#command {
    height: 1;
    border: none;
    padding: 0 1;
    background: $background;
}

#command-category {
    width: auto;
    padding: 0 1;
    color: $accent;
    text-style: bold;
}

CategoryPicker {
    align: center middle;
}

#category-list {
    width: 40;
    height: auto;
    max-height: 20;
    border: round $primary;
}

#page-title {
    padding: 1 0;
    text-style: bold;
}

#switcher {
    height: 1fr;
}

#overview {
    height: auto;
}

.card {
    width: 1fr;
    height: 5;
    padding: 1 2;
    margin-right: 1;
    border: round $primary;
}

#mode-view {
    height: 1fr;
}

#entries {
    height: 1fr;
}

#detail-pane {
    height: 12;
    padding: 0 1;
    border: round $primary;
}
