LoginScreen {
    align: center middle;
}

#login-box {
    width: 44;
    height: auto;
    padding: 1 2;
    border: round $primary;
}

#login-box Input {
    margin-top: 1;
}

#login-error {
    color: $error;
}

.hint {
    color: $accent;
}

#panes {
    height: 1fr;
}

#sidebar {
    width: 24;
    height: 1fr;
    border-right: solid $primary;
}

#main-pane {
    padding: 0 1;
}

#page-title {
    padding: 1 0;
    text-style: bold;
}

#switcher {
    height: 1fr;
}

#overview {
    height: auto;
}

.card {
    width: 1fr;
    height: 5;
    padding: 1 2;
    margin-right: 1;
    border: round $primary;
}

#mode-view {
    height: 1fr;
}

#entries {
    height: 1fr;
}

#detail-pane {
    height: 12;
    padding: 0 1;
    border: round $primary;
}
