LoginScreen {
    align: center middle;
}

#login-box {
    width: 44;
    height: auto;
    padding: 1 2;
    border: round $primary;
}

#login-box Input {
    margin-top: 1;
}

#login-error {
    color: $error;
}

.hint {
    color: $accent;
}

#breadcrumb {
    height: 1;
    padding: 0 1;
    background: $primary;
    color: $text;
    text-style: bold;
}

#modeline {
    height: 1;
    background: $panel;
    color: $text;
}

#completions {
    display: none;
    height: auto;
    max-height: 8;
    padding: 0 1;
    border-top: solid $primary;
}

#command-row {
    height: 1;
}

#command {
    height: 1;
    border: none;
    padding: 0 1;
    background: $background;
}

#command-category {
    width: auto;
    padding: 0 1;
    color: $accent;
    text-style: bold;
}

CategoryPicker {
    align: center middle;
}

#category-list {
    width: 40;
    height: auto;
    max-height: 20;
    border: round $primary;
}

#switcher {
    height: 1fr;
}

#overview {
    height: auto;
}

.card {
    width: 1fr;
    height: 5;
    padding: 1 2;
    margin-right: 1;
    border: round $panel-lighten-2;
}

#mode-view {
    height: 1fr;
}

#left-column {
    width: 45;
}

#tag-filter {
    height: 1fr;
    border: round $panel-lighten-2;
    border-subtitle-align: right;
    background: $background;
}

#entries {
    height: 2fr;
    border: round $panel-lighten-2;
    border-subtitle-align: right;
    background: $background;
}

#detail-pane {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
    border: round $panel-lighten-2;
}

#tag-filter:focus, #entries:focus {
    border: round $success;
    border-title-color: $success;
    border-title-style: bold;
}

#tag-filter:focus > .option-list--option-highlighted, #tag-filter > .option-list--option-highlighted {
    background: $primary;
}

#entries > .datatable--cursor {
    background: $primary;
}

#entries:focus > .datatable--cursor {
    background: $primary;
    text-style: bold;
}

#detail {
    margin: 0;
    padding: 0;
}
